# Hichki environment variables
#
# Copy this file to .env (or .env.local) and fill in the values:
#   cp .env.example .env
# Both are git-ignored. Never commit real keys. If both exist, .env.local wins.
#
# Sections:
#   1. App server       (no accounts needed)
#   2. Sarvam AI        (speech to text, translation, chat)
#   3. Flagsmith        (feature flags and the room experiment)
#   4. NudgeBee         (used by the cluster setup script only, not by the app)
#   5. Kubernetes       (used by the deploy scripts only)


# ---------------------------------------------------------------------------
# 1. App server
# ---------------------------------------------------------------------------

# Port the Node server listens on. Defaults to 8080.
PORT=8080

# Public HTTPS address of the app. Used to build the QR code and the away link.
# Phones only allow the microphone and camera on HTTPS, so this must be https.
# Leave empty during local development (falls back to http://localhost:PORT).
# How to get it: the deploy step prints it (Cloudflare quick tunnel or ingress URL).
PUBLIC_BASE_URL=

# Folder for the SQLite database and uploaded photos and audio.
# In Kubernetes this is the mounted persistent volume.
DATA_DIR=./data

# Largest upload accepted, in megabytes (photos and voice notes).
MAX_UPLOAD_MB=10

# Log level for the JSON logs NudgeBee reads: debug, info, warn, error.
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# 2. Sarvam AI
# Docs: https://docs.sarvam.ai
# ---------------------------------------------------------------------------

# Required. Server-side only; it is never sent to the browser.
# How to get it:
#   1. Sign in at https://dashboard.sarvam.ai
#   2. Open API keys (key management) and create a key.
#   3. Paste it here. Sent as the "api-subscription-key" header.
# New verified accounts get Rs 100 of free credit. HTTP 402 means credit ran out.
SARVAM_API_KEY=

# Speech to text model. saaras:v4 is the current recommended model.
# The sync API accepts webm, mp4/m4a, ogg, wav and mp3, up to 30 seconds per clip.
SARVAM_STT_MODEL=saaras:v4

# Chat model that turns a transcribed request into a short card (JSON output).
# sarvam-m is deprecated; use sarvam-105b.
SARVAM_CHAT_MODEL=sarvam-105b

# Translation model. sarvam-translate:v1 covers all 22 scheduled Indian
# languages (Punjabi included), up to 2,000 characters per request.
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1


# ---------------------------------------------------------------------------
# 3. Flagsmith
# Docs: https://docs.flagsmith.com
#
# How Hichki uses it: the server polls Flagsmith (local evaluation) and pushes
# every flag change to all phones over the live connection, so flipping a flag
# in the dashboard changes every phone in the room within seconds.
# (Flagsmith's own real-time streaming is Enterprise only, so we do not use it.)
#
# One-time setup in the dashboard (https://app.flagsmith.com):
#   1. Create an organisation, then a project named "hichki".
#      Use the "Development" environment it creates.
#   2. Create these three standard flags, each switched ON:
#        hichki        shows the Hichki button on guest phones
#        jab_kholna    allows locked voice letters
#        ai_requests   OFF means typed requests only (no Sarvam call)
#      Names are case-sensitive and must match exactly.
#   3. Stretch (room experiment), only if there is time:
#        a. Create a multivariate flag "request_mode" with two variations,
#           each with a label: "room" (control, whole room can answer) and
#           "nominee" (one named person is asked).
#        b. Connect the managed Flagsmith warehouse for the environment.
#           Experiment events are rejected without one.
#        c. Create a metric on the event "request_fulfilled".
#        d. Create the experiment on "request_mode" with a 50/50 split.
#      The unit is the gathering: its id is the Flagsmith identity.
# ---------------------------------------------------------------------------

# Required. Server-side environment key. Secret; never sent to the browser.
# How to get it: Flagsmith dashboard > your project > Development environment >
#   Environment settings > Keys > Server-side environment keys > Create.
#   It starts with "ser.".
FLAGSMITH_SERVER_SIDE_ENVIRONMENT_KEY=

# How often the server re-fetches flags, in seconds. Lower means faster flips
# on stage but more API requests. 10 is a good balance for a live demo.
FLAGSMITH_REFRESH_SECONDS=10

# Turn on the request_mode experiment (stretch). Set to "on" only after the
# managed warehouse is connected in Flagsmith (step 3b above), because the
# experiment's events are rejected without one.
FLAGSMITH_EXPERIMENTS=off

# Only change this when self-hosting Flagsmith.
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/


# ---------------------------------------------------------------------------
# 4. NudgeBee
# Docs: https://docs.nudgebee.com
#
# The app does not talk to NudgeBee. The NudgeBee agent runs inside the
# cluster, watches the app's pods, events, logs and metrics, and NudgeBee's
# AI investigates when we break the app on purpose.
# This value is read only by the cluster setup script.
# ---------------------------------------------------------------------------

# Required for the cluster step. NudgeBee agent auth key.
# How to get it:
#   1. Sign in at https://app.nudgebee.com
#   2. Admin > Integrations > Kubernetes Clusters > "Add K8s Account".
#   3. Name it "hichki", mark it Non-production, click Next.
#   4. "Finish Setup" shows an install command; copy the auth key from it.
NUDGEBEE_AGENT_KEY=


# ---------------------------------------------------------------------------
# 5. Kubernetes (deploy scripts only)
# ---------------------------------------------------------------------------

# Name of the local kind cluster the scripts create.
CLUSTER_NAME=hichki

# Namespace the app runs in. NudgeBee questions name this namespace.
APP_NAMESPACE=hichki
